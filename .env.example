# Copy this file to `.env` and fill in the values.
# Do not commit `.env`.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
BDNAME=vigor_max_capsul
# DBNAME is accepted as a fallback if BDNAME is empty
# DBNAME=

# -----------------------------------------------------------------------------
# Admin dashboard (required)
# Login: /admin/login
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_SECRET=change_this_long_random_secret

# -----------------------------------------------------------------------------
# MiMSMS — order confirmation SMS (required for SMS)
# -----------------------------------------------------------------------------
MIMSMS_USERNAME=your_username
MIMSMS_API_KEY=your_api_key
MIMSMS_SENDER_NAME=your_sender_name
MIMSMS_BRAND_NAME=EZ ALIF Shop
MIMSMS_API_URL=https://api.mimsms.com/api/SmsSending/SMS
MIMSMS_TRANSACTION_TYPE=T
# Required only when MIMSMS_TRANSACTION_TYPE=P
MIMSMS_CAMPAIGN_ID=

# -----------------------------------------------------------------------------
# Meta Pixel (browser) — optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# -----------------------------------------------------------------------------
# Meta Conversions API (server) — optional
# -----------------------------------------------------------------------------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_CAPI_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# Steadfast courier — optional, used from admin panel
# -----------------------------------------------------------------------------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# -----------------------------------------------------------------------------
# Pathao courier — optional, used from admin panel
# -----------------------------------------------------------------------------
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_SANDBOX=false

# -----------------------------------------------------------------------------
# BD Courier customer check — optional, used from admin panel
# Token stays server-side only (never NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
BD_COURIER_API_URL=https://api.bdcourier.com
BD_COURIER_API_TOKEN=YOUR_API_TOKEN

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
